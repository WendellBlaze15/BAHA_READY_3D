# Copy to .env.local (repo root) and fill in. NEVER commit real values.
# Run `pnpm setup check-env` to see which keys are missing (names only).

# ── Public (safe in client bundle) ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000        # your deployed URL in production
NEXT_PUBLIC_SUPABASE_URL=                        # Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=                   # publishable key (sb_publishable_...)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                    # generated by `pnpm setup generate`
NEXT_PUBLIC_SENTRY_DSN=                          # optional: Sentry > Project > Client Keys
NEXT_PUBLIC_POSTHOG_KEY=                         # optional
NEXT_PUBLIC_POSTHOG_HOST=                        # optional
NEXT_PUBLIC_GAME_SERVER_URL=                     # Survival game server, e.g. wss://<service>.up.railway.app (local: ws://localhost:2567)

# ── Server only (never in client) ──────────────────────────
SUPABASE_SERVICE_ROLE_KEY=                       # secret key (sb_secret_...), fetched by setup script
SUPABASE_PROJECT_REF=                            # the xxxx in https://xxxx.supabase.co
SUPABASE_DB_PASSWORD=                            # set when the project was created
UPSTASH_REDIS_REST_URL=                          # Upstash console > database > REST API
UPSTASH_REDIS_REST_TOKEN=
BREVO_API_KEY=                                   # Brevo > SMTP & API > API keys (xkeysib-...)
BREVO_SMTP_LOGIN=                                # Brevo > SMTP & API > SMTP (login)
BREVO_SMTP_KEY=                                  # Brevo SMTP key (xsmtpsib-...)
BREVO_SENDER_EMAIL=                              # verified sender in Brevo > Senders
BREVO_SENDER_NAME=Baha Ready
BREVO_SMS_SENDER=BahaReady                       # optional, only if SMS OTP enabled
SMS_OTP_ENABLED=false
ATTEMPT_TOKEN_SECRET=                            # generated by `pnpm setup generate`
SEND_SMS_HOOK_SECRET=                            # generated by Supabase when the SMS hook is created
EMAIL_WEBHOOK_SECRET=                            # generated
CRON_SECRET=                                     # generated
VAPID_PRIVATE_KEY=                               # generated
FCM_SERVICE_ACCOUNT_JSON=                        # base64 of Firebase service account JSON
GOOGLE_OAUTH_CLIENT_ID=                          # optional (Google Cloud console)
GOOGLE_OAUTH_CLIENT_SECRET=                      # optional
SENTRY_AUTH_TOKEN=                               # optional, for source map upload in CI
SENTRY_ORG=
SENTRY_PROJECT=
WEATHER_LAT=14.23
WEATHER_LON=121.36

# ── Survival game server (apps/game-server) ────────────
GAME_SERVER_HTTP_URL=                            # https://<service>.up.railway.app (admin API, server-to-server)
GAME_SERVER_ADMIN_SECRET=                        # 32+ random chars; same value on Vercel and Railway
# Railway-only (set on the service, not Vercel): ALLOWED_ORIGINS=https://<your-app>.vercel.app
# Local tooling only — never commit (used by `pnpm run setup railway` / `railway-deploy`):
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=                            # only needed the first time (creates the project)
# CI deploys use a separate PROJECT token stored as the GitHub secret RAILWAY_TOKEN (never here).

# ── Seed staff accounts (scripts/seed-staff.ts only) ───────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_EMAIL=                           # non-deliverable internal address is fine
SEED_SUPERADMIN_PASSWORD=

# ── Tooling / CLI only ─────────────────────────────────────
VERCEL_TOKEN=                                    # vercel.com/account/tokens
VERCEL_ORG_ID=                                   # filled by setup script
VERCEL_PROJECT_ID=                               # filled by setup script
SUPABASE_ACCESS_TOKEN=                           # supabase.com/dashboard/account/tokens (sbp_...)

# Android release signing (keystore file is git-ignored — back it up offline)
ANDROID_KEYSTORE_PATH=apps/mobile/keystore/release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=bahaready
